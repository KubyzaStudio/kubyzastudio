# ------------------------------------------------------------------
# Kubyza Studio — variables d'environnement
# Copier ce fichier en `.env.local` (dev Next.js) et `.dev.vars` (dev Wrangler).
# En production : Cloudflare Pages > Settings > Environment variables.
# ------------------------------------------------------------------

# URL publique du site (utilisée pour le SEO, le sitemap et les Open Graph)
NEXT_PUBLIC_SITE_URL=https://kubyza.studio

# --- Canaux directs (section « Signal » + pied de page) ---
# Ces trois adresses sont la seule source de vérité : elles alimentent
# l'objet 3D, le panneau de connexion, le pied de page et le balisage SEO.
# Laisser vide pour conserver les valeurs par défaut de `src/data/site.ts`.
NEXT_PUBLIC_SNAPCHAT_URL=https://snapchat.com/add/kubyza.studio
# À confirmer : seul canal dont l'identifiant diffère des deux autres.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/kubyzastudio
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/kubyza.studio

# --- Envoi des emails (Resend) — utilisé par functions/api/contact.ts ---
RESEND_API_KEY=
# Expéditeur vérifié dans Resend (ex: "Kubyza Studio <mission@kubyza.studio>")
# Doit appartenir à un domaine vérifié : une adresse Gmail sera refusée.
CONTACT_FROM_EMAIL=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=kubyza.studio@gmail.com

# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
# Dashboard > Project Settings > API. Ces variables restent côté serveur :
# elles alimentent les Cloudflare Pages Functions, jamais le navigateur.
# Aucune ne doit être préfixée NEXT_PUBLIC_.
SUPABASE_URL=

# --- Avis clients (obligatoire pour /api/reviews) ---
# Clé « anon / public ». C'est la seule clé utilisée par le système d'avis :
# les règles RLS de `supabase/reviews.sql` bornent entièrement ce qu'elle
# permet — lire les avis approuvés, déposer un avis en attente, rien d'autre.
SUPABASE_ANON_KEY=

# --- Archivage des demandes de contact (facultatif) ---
# Cette clé CONTOURNE les règles RLS : elle ne sert qu'à `/api/contact` et
# ne doit jamais être exposée au navigateur ni utilisée pour les avis.
SUPABASE_SERVICE_ROLE_KEY=
